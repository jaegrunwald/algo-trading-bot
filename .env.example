# Copy to `.env` and fill in secrets. What consumes what: see ARCHITECTURE.md in repo root.
#
# Comma-separated tickers for the Flask rating app / demos (`rating_engine/config.py`).
# This is NOT the Finviz list used by `main.py` (that list comes from `scripts/scanner.py`).
WATCHLIST_TICKERS=AAPL,MSFT,GOOGL,HIMS,AMD,NVDA,GEV,SU,SNDK

# Local dev: macOS often uses port 5000 for AirPlay; 5001 is a safe default.
PORT=5001
# When using: flask --app wsgi run
FLASK_RUN_PORT=5001

# Trained sklearn artifact for GET /api/rating/<ticker> (train with scripts/train_rating_model.py)
RATING_MODEL_PATH=models/rating_model.joblib
# Optional: override trained inference.probability_floor without retraining (e.g. 0.1)
# RATING_PROBABILITY_FLOOR=0.1

# Alpaca paper trading (https://app.alpaca.markets/paper/dashboard/overview)
# Used by main.py and by dashboard/server.js (repo .env is loaded for `npm start` in dashboard/).
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# true = paper API (default). Set false only for live keys.
ALPACA_PAPER=true
# Buy-and-hold SPY benchmark notional for portfolio_stats.csv
INITIAL_CAPITAL=100000
# Optional: history length for ML features in main.py
ML_RATING_PERIOD=2y
# Minimum ML rating to open a long: Strong Buy (default), or Buy / Hold / … (see main.py _RATING_LADDER).
# Example: ENTRY_MIN_RATING=Buy enters on Buy or Strong Buy (more trades than Strong Buy only).
ENTRY_MIN_RATING=Buy

# Seconds to sleep after each watchlist ticker ML call (yfinance throttle; default 1)
YF_THROTTLE_SEC=1

# Cap concurrent long positions (Phase 3); default 20
MAX_CONCURRENT_POSITIONS=20

# Benchmarking dashboard (Phase 4): Node listen port — do NOT reuse Flask PORT above.
DASHBOARD_PORT=3000
# Bind address: 0.0.0.0 for Docker; use 127.0.0.1 only if you need to restrict to loopback.
# DASHBOARD_LISTEN_HOST=0.0.0.0
DASHBOARD_HOST_PORT=3000
RATING_ENGINE_URL=http://localhost:5001
PORTFOLIO_STATS_PATH=portfolio_stats.csv

# Simulated equity when running: python main.py --dry-run (no Alpaca keys in .env)
DRY_RUN_EQUITY=100000
